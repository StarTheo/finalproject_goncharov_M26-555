# Виртуальное окружение
.venv/

# Кэши Python и инструментов
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/

# Результаты сборки
build/
dist/
wheels/
*.egg-info/

# Локальные данные и журналы
data/*.json
logs/

# Переменные окружения и секретные ключи
.env
.env.*
!.env.example

# Временные файлы
*.tmp

# Локальные записи терминала
*.cast